{
  "name": "v.logue.dev",
  "version": "2.3.0",
  "private": true,
  "description": "A personal portfolio site about programming, technology, and software development.",
  "homepage": "https://v.logue.dev",
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/logue/v.logue.dev.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev --open",
    "dev:wrangler": "wrangler pages dev",
    "lint": "run-s lint:*",
    "lint:check": "vize lint --type-aware",
    "lint:oxlint": "vp lint --fix",
    "lint:oxfmt": "vp fmt",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:analyze": "vp build --mode analyze",
    "build:clean": "rimraf dist",
    "preview": "vp preview",
    "clean": "rimraf dist",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.vite node_modules/.vite-tmp",
    "build-only": "vp build",
    "type-check": "vize check --tsconfig tsconfig.app.json",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "vp config && pnpm run skills:install"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.9",
    "fflate": "^0.8.3",
    "pinia": "^4.1.0",
    "three": "^0.187.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify/vue": "^5.0.5",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-security": "^4.2.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "rollup-plugin-visualizer": "^7.1.3",
    "sass-embedded": "^1.108.2",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-checker": "^1.0.0",
    "vite-plugin-glsl": "^1.6.3",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vize": "^0.763.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.21.0"
}
